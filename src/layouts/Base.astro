---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import '../styles/movimiento.css';
import Icono from '../components/Icono.astro';
import { url, situaciones, provincias, listaTemas } from '../lib/datos';
import { NOMBRE, GOATCOUNTER } from '../config';

interface Props {
  titulo: string;
  descripcion?: string;
  tema?: string;
  fondo?: 'paper' | 'neutral';
  nav?: 'para-ti' | 'provincia' | 'mas' | null;
}
const { titulo, descripcion = `Qué propone cada partido sobre ${listaTemas}, en corto y con la fuente. Sin cuentas y sin guardar nada.`, tema, fondo, nav = null } = Astro.props;
const tituloCompleto = titulo === NOMBRE ? `${NOMBRE} · elecciones generales 29N` : `${titulo} · ${NOMBRE}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const datosPerfil = {
  situaciones: Object.fromEntries(situaciones.situaciones.map((s) => [s.id, s.corta])),
  provincias: Object.fromEntries(provincias.map((p) => [p.slug, p.nombre])),
  base: url(),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#1A1A1A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary" />
    {GOATCOUNTER && <script is:inline async data-goatcounter={GOATCOUNTER} src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body data-tema={tema} data-fondo={fondo}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot name="cabecera" />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    {nav !== null && (
      <nav class="nav" aria-label="Secciones">
        <a href={url('para-ti')} aria-current={nav === 'para-ti' ? 'page' : undefined}>Para ti</a>
        <a href={url('provincia')} data-enlace-provincia aria-current={nav === 'provincia' ? 'page' : undefined}>Tu provincia</a>
        <a href={url('mas')} aria-current={nav === 'mas' ? 'page' : undefined}>Más</a>
      </nav>
    )}

    <dialog class="hoja" id="hoja-glosario" aria-labelledby="glosario-titulo">
      <div class="hoja__panel">
        <div class="hoja__asa" aria-hidden="true"></div>
        <div class="hoja__cabecera">
          <h2 class="h2" id="glosario-titulo" data-nombre></h2>
          <button type="button" class="boton-icono" data-cerrar aria-label="Cerrar"><Icono nombre="cerrar" tam={18} /></button>
        </div>
        <p data-definicion></p>
        <a href={url('mas/glosario')} class="pequeno">Ver todo el glosario</a>
      </div>
    </dialog>

    <script type="application/json" id="datos-perfil" set:html={JSON.stringify(datosPerfil)} />
    <script>
      import { prepararHojas, prepararGlosario } from '../scripts/hojas';
      import { perfil } from '../scripts/perfil';
      import { animarFormas } from '../scripts/formas';
      import { faviconAnimado } from '../scripts/favicon';

      prepararHojas();
      prepararGlosario();

      const datos = JSON.parse(document.getElementById('datos-perfil')!.textContent!);
      const p = perfil();

      // Píldora "Alquilo · Madrid · Cambiar"
      document.querySelectorAll<HTMLElement>('[data-pildora-texto]').forEach((el) => {
        const partes = [
          p.situaciones.map((s: string) => datos.situaciones[s]).filter(Boolean).slice(0, 2).join(' y '),
          p.provincia ? datos.provincias[p.provincia] : '',
        ].filter(Boolean);
        if (partes.length) {
          el.innerHTML = '';
          el.append(`${partes.join(' · ')} · `);
          const u = document.createElement('u');
          u.textContent = 'Cambiar';
          el.append(u);
          el.parentElement!.setAttribute('aria-label', `Tu perfil: ${partes.join(', ')}. Cambiar`);
        }
      });
      // Al cambiar el perfil, se vuelve a la página en la que estabas.
      document.querySelectorAll('[data-cambiar]').forEach((a) =>
        a.addEventListener('click', () => {
          try { sessionStorage.setItem('ltt-volver', location.pathname); } catch {}
        }),
      );
      // "Tu provincia" lleva directamente a la tuya si ya la has elegido.
      if (p.provincia) {
        document.querySelectorAll<HTMLAnchorElement>('[data-enlace-provincia]').forEach((a) => {
          a.href = `${datos.base}provincia/${p.provincia}/`;
        });
      }
      // Microinteracciones (ver styles/movimiento.css). Nada si se pide menos movimiento.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('.formas-temas, .formas-mini').forEach(animarFormas);
        // Entrada de cada pantalla: los elementos visibles se colocan uno detrás de otro
        const cont = document.querySelector<HTMLElement>('main > .contenedor');
        if (cont) {
          let n = 0;
          [...cont.children].forEach((el) => {
            const h = el as HTMLElement;
            if (h.getBoundingClientRect().top < innerHeight) h.style.setProperty('--n', String(n++));
            else h.style.animation = 'none';
          });
          cont.classList.add('escena');
          setTimeout(() => cont.classList.remove('escena'), 900 + n * 55 + 100);
        }
        // Logo: ola de letras
        document.querySelectorAll<HTMLElement>('.marca').forEach((m) => {
          const texto = m.textContent ?? '';
          m.innerHTML = `<span class="solo-lector">${texto}</span>` + [...texto].map((c, i) => `<span class="letra" aria-hidden="true" style="--l:${i}">${c}</span>`).join('');
          const ola = () => {
            if (m.classList.contains('ola')) return;
            m.classList.add('ola');
            setTimeout(() => m.classList.remove('ola'), 700 + texto.length * 28);
          };
          m.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') ola(); });
          if (m.closest('.portada')) setTimeout(ola, 500);
        });
        // La tarjeta pulsada viaja hasta el titular de la siguiente pantalla
        document.addEventListener('click', (e) => {
          const a = (e.target as Element).closest<HTMLAnchorElement>('a.tarjeta-enlace');
          const t = a?.querySelector<HTMLElement>('.titulo');
          if (!t) return;
          t.style.viewTransitionName = 'titular';
          try { sessionStorage.setItem('transicion-titular', '1'); } catch {}
        });
        // Al volver atrás (bfcache), quita el nombre puesto a mano
        addEventListener('pageshow', () => {
          document.querySelectorAll<HTMLElement>('.tarjeta-enlace .titulo').forEach((el) => (el.style.viewTransitionName = ''));
        });
        const porRevelar = [...document.querySelectorAll<HTMLElement>('main .tarjeta, main .tarjeta-enlace, main .respuesta')]
          .filter((el) => el.getBoundingClientRect().top > innerHeight);
        if ('IntersectionObserver' in window && porRevelar.length) {
          const io = new IntersectionObserver((entradas) => {
            entradas.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              el.classList.add('revelado');
              requestAnimationFrame(() => el.classList.remove('por-revelar'));
              setTimeout(() => el.classList.remove('revelado'), 700);
              io.unobserve(el);
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          porRevelar.forEach((el) => { el.classList.add('por-revelar'); io.observe(el); });
        }
      }
      faviconAnimado();
      // Modo sin conexión: guarda la web en el navegador (ver integraciones/sin-conexion.mjs).
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${datos.base}sw.js`, { scope: datos.base }).catch(() => {});
        });
      }
    </script>
    <script is:inline>
      // Transición entre pantallas: si se llegó pulsando una tarjeta, su título se convierte en el titular.
      addEventListener('pagereveal', function () {
        try {
          if (sessionStorage.getItem('transicion-titular')) {
            sessionStorage.removeItem('transicion-titular');
            var h = document.querySelector('h1');
            if (h) h.style.viewTransitionName = 'titular';
          }
        } catch (e) {}
      });
    </script>
  </body>
</html>
