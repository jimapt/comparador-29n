---
// Simulador de reparto con los votos reales de 2023 en cada provincia.
// Se presenta siempre como simulación: arranca en 2023, no es una encuesta
// ni una estimación del 29N (decisión de Laura, 02/11/2026).
import { resultados2023, fuenteResultados2023 } from '../lib/datos';

interface Props { escanos: number; escanos2023: number; provincia: string; slug: string }
const { escanos, escanos2023, provincia, slug } = Astro.props;
const r = resultados2023[slug];
const validos = r.partidos.reduce((a, p) => a + p.votos, 0) + r.blanco;
const pct = (v: number) => Math.round((v / validos) * 1000) / 10;
// Color principal de cada partido (Laura, 04/11), aproximado al de su marca. Va junto al patrón,
// que se mantiene para no depender solo del color.
const COLORES: Record<string, string> = {
  PP: '#1D84CE', PSOE: '#E30613', Vox: '#63BE21', Sumar: '#E51C55', PSC: '#E73B39', ERC: '#FFB232',
  Junts: '#20C0B2', CUP: '#FFED00', BNG: '#76B3DD', 'EH Bildu': '#B5CF18', PNV: '#4AAE4A', UPN: '#2A52BE',
  'Coalición Canaria': '#FFD700', 'Nueva Canarias': '#8DC63F', 'Teruel Existe': '#0F7B4A', 'Por Ávila': '#7FB539',
  UPL: '#B22234', 'Soria ¡Ya!': '#2F8D46', 'Coalición por Melilla': '#00A650',
};
const partidos = r.partidos.map((p, i) => ({ ...p, i, pct: pct(p.votos), color: COLORES[p.nombre] ?? '#ffffff' }));
const blanco = pct(r.blanco);
const fmt = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 1 });
const con2023 = partidos.filter((p) => p.escanos > 0).map((p) => `${p.nombre} ${p.escanos}`).join(', ');
---
<section class="tarjeta pila simulador" style="--gap: 0.875rem" aria-labelledby="sim-t" data-simulador data-escanos={escanos} data-blanco={blanco}>
  <h2 class="h2" id="sim-t">Prueba cómo se reparten</h2>
  <p class="aviso pequeno"><strong>Esto es una simulación.</strong> Empieza con los votos que sacó cada partido en {provincia} en 2023. No es una encuesta ni una previsión del 29N.</p>
  <p class="pequeno">En 2023 {provincia} repartió {escanos2023} {escanos2023 === 1 ? 'escaño' : 'escaños'}: {con2023}.{escanos !== escanos2023 && ` El 29N reparte ${escanos}, así que con los mismos votos el resultado puede cambiar.`} Mueve los porcentajes y mira qué pasa con los {escanos} de ahora.</p>
  <div class="pila" style="--gap: 0.5rem">
    {partidos.map((p) => (
      <div class="deslizador">
        <label for={`sim-${slug}-${p.i}`} class="nombre"><span class={`muestra p-${p.i}`} style={`--pc: ${p.color}`} aria-hidden="true"></span>{p.nombre}</label>
        <output id={`sim-${slug}-${p.i}-r`} for={`sim-${slug}-${p.i}`} class="pequeno" data-resultado={p.i}></output>
        <input id={`sim-${slug}-${p.i}`} type="range" min="0" max="80" step="0.5" value={p.pct} data-inicial={p.pct} data-color={p.color} data-partido={p.i} data-nombre={p.nombre} aria-describedby={`sim-${slug}-${p.i}-r`} />
      </div>
    ))}
  </div>
  <div class="escanos" aria-hidden="true" data-bloques></div>
  <p class="pequeno" role="status" aria-live="polite" data-explicacion></p>
  <button type="button" class="boton boton--sec" data-reiniciar>Volver a los votos de 2023</button>
  <details>
    <summary class="pequeno"><strong>Ver el reparto en una tabla</strong></summary>
    <table class="tabla pequeno">
      <caption class="solo-lector">Reparto de escaños de la simulación</caption>
      <thead><tr><th scope="col">Partido</th><th scope="col">% de votos</th><th scope="col">Escaños</th></tr></thead>
      <tbody data-tabla></tbody>
    </table>
  </details>
  <p class="pequeno">
    Se usa la <button type="button" class="termino" data-nombre="D'Hondt" data-definicion="Fórmula que reparte los escaños de cada provincia: divide los votos de cada partido entre 1, 2, 3… y da los escaños a los resultados más altos." aria-haspopup="dialog">fórmula D'Hondt</button>
    y el <button type="button" class="termino" data-nombre="Umbral del 3 %" data-definicion="En cada provincia, los partidos con menos del 3 % de los votos válidos (incluido el voto en blanco) no entran en el reparto." aria-haspopup="dialog">umbral del 3 %</button>.
    El voto en blanco ({fmt(blanco)} % en 2023) cuenta para el umbral y no se mueve.
  </p>
  <p class="pequeno secundario">
    <strong>Fuente:</strong> <a href={fuenteResultados2023.url} target="_blank" rel="noopener noreferrer">escrutinio del Ministerio del Interior<span class="solo-lector"> (se abre en otra pestaña)</span></a>.
    El resultado definitivo lo publicó la Junta Electoral Central en el <a href={fuenteResultados2023.definitivo.url} target="_blank" rel="noopener noreferrer">BOE<span class="solo-lector"> (se abre en otra pestaña)</span></a> y puede variar unos cientos de votos, porque suma el voto desde el extranjero.
    {slug === 'madrid' && fuenteResultados2023.notaMadrid}
    Solo aparecen los partidos que pasaron del 3 % en {provincia}, y los porcentajes se calculan sin los demás, así que pueden variar unas décimas respecto a los oficiales.
  </p>
</section>

<style>
  .deslizador { display: grid; grid-template-columns: 1fr auto; gap: 0 0.625rem; align-items: center; }
  .deslizador input { grid-column: 1 / -1; }
  .nombre { font-family: var(--display); font-weight: 700; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; }
  input[type='range'] { width: 100%; min-height: 2.75rem; accent-color: var(--ink); }
  output { text-align: right; font-weight: 600; white-space: nowrap; }
  .escanos { display: grid; grid-template-columns: repeat(auto-fill, minmax(1.5rem, 1fr)); gap: 0.25rem; }
  .escanos :global(span), .muestra { height: 1.5rem; border-radius: 6px; border: 2px solid var(--ink); }
  .muestra { width: 1.25rem; height: 1.25rem; flex: none; }
  /* Color del partido (--pc) con un patrón distinto para cada uno */
  :global(.simulador .p-0) { background: var(--pc, #fff); }
  :global(.simulador .p-1) { background: repeating-linear-gradient(45deg, var(--ink) 0 2px, var(--pc, #fff) 2px 6px); }
  :global(.simulador .p-2) { background: radial-gradient(circle, var(--ink) 1.5px, var(--pc, #fff) 1.6px) 0 0 / 6px 6px; }
  :global(.simulador .p-3) { background: conic-gradient(var(--ink) 25%, var(--pc, #fff) 0 50%, var(--ink) 0 75%, var(--pc, #fff) 0) 0 0 / 8px 8px; }
  :global(.simulador .p-4) { background: repeating-linear-gradient(0deg, var(--ink) 0 2px, var(--pc, #fff) 2px 6px); }
  :global(.simulador .p-5) { background: repeating-linear-gradient(-45deg, var(--ink) 0 1.5px, transparent 1.5px 6px), repeating-linear-gradient(45deg, var(--ink) 0 1.5px, var(--pc, #fff) 1.5px 6px); }
  :global(.simulador .p-6) { background: repeating-linear-gradient(90deg, var(--ink) 0 2px, var(--pc, #fff) 2px 6px); }
  summary { cursor: pointer; min-height: 2.75rem; display: flex; align-items: center; }
  .tabla { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  .tabla th, .tabla :global(td) { text-align: left; padding: 0.375rem 0.25rem; border-bottom: 1.5px solid var(--ink); }
</style>

<script>
  export function dhondt(votos: number[], blanco: number, escanos: number) {
    const validos = votos.reduce((a, b) => a + b, 0) + blanco;
    const entran = votos.map((v) => validos > 0 && v > 0 && v / validos >= 0.03);
    const res = votos.map(() => 0);
    for (let n = 0; n < escanos && entran.some(Boolean); n++) {
      let mejor = -1;
      for (let k = 0; k < votos.length; k++) {
        if (!entran[k]) continue;
        if (mejor < 0) { mejor = k; continue; }
        const c = votos[k] / (res[k] + 1);
        const cm = votos[mejor] / (res[mejor] + 1);
        if (c > cm || (c === cm && votos[k] > votos[mejor])) mejor = k;
      }
      res[mejor]++;
    }
    return { res, validos, entran };
  }

  const fmt = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 1 });

  document.querySelectorAll<HTMLElement>('[data-simulador]').forEach((sim) => {
    const escanos = Number(sim.dataset.escanos);
    const blanco = Number(sim.dataset.blanco);
    const inputs = [...sim.querySelectorAll<HTMLInputElement>('input[type=range]')];
    const nombres = inputs.map((i) => i.dataset.nombre!);
    const bloques = sim.querySelector('[data-bloques]')!;
    const explicacion = sim.querySelector('[data-explicacion]')!;
    const tabla = sim.querySelector('[data-tabla]')!;
    // escala < 1 solo durante la animación de entrada: los escaños son los finales y el % crece desde 0
    function pintar(escala = 1) {
      const votos = inputs.map((i) => Number(escala < 1 ? i.dataset.inicial : i.value));
      const { res, validos, entran } = dhondt(votos, blanco, escanos);
      bloques.innerHTML = '';
      tabla.innerHTML = '';
      votos.forEach((v, k) => {
        const pct = (validos ? (v / validos) * 100 : 0) * escala;
        sim.querySelector(`[data-resultado="${k}"]`)!.textContent = `${fmt(pct)} % · ${res[k]} esc.`;
        inputs[k].setAttribute('aria-valuetext', `${fmt(pct)} % de los votos, ${res[k]} escaños`);
        for (let i = 0; i < res[k]; i++) {
          const s = document.createElement('span');
          s.className = `p-${k}`;
          s.style.setProperty('--pc', inputs[k].dataset.color!);
          bloques.append(s);
        }
        const tr = document.createElement('tr');
        [nombres[k], `${fmt(pct)} %`, String(res[k])].forEach((t) => {
          const td = document.createElement('td');
          td.textContent = t;
          tr.append(td);
        });
        tabla.append(tr);
      });
      const fuera = nombres.filter((_, k) => !entran[k] && votos[k] > 0);
      const frases = [];
      if (escanos === 1) frases.push('Con 1 escaño, se lo lleva el partido con más votos: la fórmula no cambia nada.');
      if (fuera.length) frases.push(`${fuera.join(' y ')} ${fuera.length > 1 ? 'tienen' : 'tiene'} menos del 3 % y se ${fuera.length > 1 ? 'quedan' : 'queda'} fuera del reparto.`);
      const con = nombres.map((n, k) => (res[k] ? `${n} ${res[k]}` : '')).filter(Boolean);
      frases.push(`En esta simulación: ${con.join(', ')} de ${escanos} escaños.`);
      explicacion.textContent = frases.join(' ');
    }
    inputs.forEach((i) => i.addEventListener('input', () => pintar()));
    sim.querySelector('[data-reiniciar]')!.addEventListener('click', () => {
      inputs.forEach((i) => (i.value = i.dataset.inicial!));
      pintar();
    });
    pintar();

    // Entrada (Laura, 04/11): al verse por primera vez, los tiradores van de 0 a su sitio y el % crece.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const DURACION = 1400;
      const curva = (t: number) => 1 - Math.pow(1 - t, 3);
      const animar = () => {
        const t0 = performance.now();
        const paso = (ahora: number) => {
          const t = Math.min(1, (ahora - t0) / DURACION);
          const e = curva(t);
          inputs.forEach((i) => (i.value = String(Number(i.dataset.inicial) * e)));
          pintar(t < 1 ? e : 1);
          if (t < 1) requestAnimationFrame(paso);
          else inputs.forEach((i) => (i.value = i.dataset.inicial!));
        };
        requestAnimationFrame(paso);
      };
      inputs.forEach((i) => (i.value = '0'));
      pintar(0.0001);
      const obs = new IntersectionObserver((entradas) => {
        if (entradas.some((e) => e.isIntersecting)) { obs.disconnect(); animar(); }
      }, { threshold: 0.35 });
      obs.observe(sim);
    }
  });
</script>
