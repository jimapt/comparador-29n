---
// Simulador de reparto con partidos inventados (A, B, C, D): con partidos
// reales se leería como una estimación o una encuesta (LOREG).
interface Props { escanos: number; provincia: string }
const { escanos, provincia } = Astro.props;
const partidos = [
  { id: 'A', votos: 38 }, { id: 'B', votos: 30 }, { id: 'C', votos: 20 }, { id: 'D', votos: 2 },
];
---
<section class="tarjeta pila simulador" style="--gap: 0.875rem" aria-labelledby="sim-t" data-simulador data-escanos={escanos}>
  <h2 class="h2" id="sim-t">Prueba cómo se reparten</h2>
  <p class="pequeno secundario">Mueve los votos de los partidos A, B, C y D y mira cómo cambian los {escanos} escaños de {provincia}. Son partidos inventados.</p>
  <div class="pila" style="--gap: 0.625rem">
    {partidos.map((p) => (
      <div class="deslizador">
        <label for={`sim-${p.id}`} class="letra"><span class="solo-lector">Votos del partido </span>{p.id}</label>
        <input id={`sim-${p.id}`} type="range" min="0" max="100" step="1" value={p.votos} data-partido={p.id} aria-describedby={`sim-${p.id}-r`} />
        <output id={`sim-${p.id}-r`} for={`sim-${p.id}`} class="pequeno" data-resultado={p.id}></output>
      </div>
    ))}
  </div>
  <div class="escanos" aria-hidden="true" data-bloques></div>
  <p class="pequeno" role="status" aria-live="polite" data-explicacion></p>
  <details>
    <summary class="pequeno"><strong>Ver el reparto en una tabla</strong></summary>
    <table class="tabla pequeno">
      <caption class="solo-lector">Reparto de escaños del simulador</caption>
      <thead><tr><th scope="col">Partido</th><th scope="col">Votos</th><th scope="col">% de votos</th><th scope="col">Escaños</th></tr></thead>
      <tbody data-tabla></tbody>
    </table>
  </details>
  <p class="pequeno">
    Se usa la <button type="button" class="termino" data-nombre="D'Hondt" data-definicion="Fórmula que reparte los escaños de cada provincia: divide los votos de cada partido entre 1, 2, 3… y da los escaños a los resultados más altos." aria-haspopup="dialog">fórmula D'Hondt</button>
    y el <button type="button" class="termino" data-nombre="Umbral del 3 %" data-definicion="En cada provincia, los partidos con menos del 3 % de los votos válidos (incluido el voto en blanco) no entran en el reparto." aria-haspopup="dialog">umbral del 3 %</button>.
  </p>
</section>

<style>
  .deslizador { display: grid; grid-template-columns: 1.75rem 1fr 4.5rem; gap: 0.625rem; align-items: center; }
  .letra { font-family: var(--display); font-weight: 700; }
  input[type='range'] { width: 100%; min-height: 2.75rem; accent-color: var(--ink); }
  output { text-align: right; font-weight: 600; }
  .escanos { display: grid; grid-template-columns: repeat(auto-fill, minmax(1.5rem, 1fr)); gap: 0.25rem; }
  .escanos :global(span) {
    height: 1.5rem; border-radius: 6px; border: 2px solid var(--ink); display: flex; align-items: center; justify-content: center;
    font-family: var(--display); font-weight: 700; font-size: 0.625rem;
  }
  .escanos :global(.p-A) { background: var(--ink); color: #fff; }
  .escanos :global(.p-B) { background: repeating-linear-gradient(45deg, var(--ink) 0 2px, #fff 2px 6px); color: var(--ink); }
  .escanos :global(.p-C) { background: radial-gradient(circle, var(--ink) 1.5px, #fff 1.6px) 0 0 / 6px 6px; }
  .escanos :global(.p-D) { background: #fff; }
  .escanos :global(span b) { background: #fff; color: var(--ink); padding: 0 2px; border-radius: 3px; }
  .escanos :global(.p-A b) { background: var(--ink); color: #fff; }
  summary { cursor: pointer; min-height: 2.75rem; display: flex; align-items: center; }
  .tabla { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  .tabla th, .tabla :global(td) { text-align: left; padding: 0.375rem 0.25rem; border-bottom: 1.5px solid var(--ink); }
</style>

<script>
  export function dhondt(votos: Record<string, number>, escanos: number) {
    const total = Object.values(votos).reduce((a, b) => a + b, 0);
    const entran = Object.keys(votos).filter((k) => total > 0 && votos[k] / total >= 0.03 && votos[k] > 0);
    const res: Record<string, number> = Object.fromEntries(Object.keys(votos).map((k) => [k, 0]));
    for (let i = 0; i < escanos && entran.length; i++) {
      let mejor = entran[0];
      for (const k of entran) {
        const c = votos[k] / (res[k] + 1);
        const cm = votos[mejor] / (res[mejor] + 1);
        if (c > cm || (c === cm && votos[k] > votos[mejor])) mejor = k;
      }
      res[mejor]++;
    }
    return { res, total, entran };
  }

  document.querySelectorAll<HTMLElement>('[data-simulador]').forEach((sim) => {
    const escanos = Number(sim.dataset.escanos);
    const inputs = [...sim.querySelectorAll<HTMLInputElement>('input[type=range]')];
    const bloques = sim.querySelector('[data-bloques]')!;
    const explicacion = sim.querySelector('[data-explicacion]')!;
    const tabla = sim.querySelector('[data-tabla]')!;
    function pintar() {
      const votos = Object.fromEntries(inputs.map((i) => [i.dataset.partido!, Number(i.value)]));
      const { res, total, entran } = dhondt(votos, escanos);
      bloques.innerHTML = '';
      tabla.innerHTML = '';
      for (const k of Object.keys(votos)) {
        const pct = total ? (votos[k] / total) * 100 : 0;
        const out = sim.querySelector(`[data-resultado="${k}"]`)!;
        out.textContent = `${res[k]} esc.`;
        for (let i = 0; i < res[k]; i++) {
          const s = document.createElement('span');
          s.className = `p-${k}`;
          const b = document.createElement('b');
          b.textContent = k;
          s.append(b);
          bloques.append(s);
        }
        const tr = document.createElement('tr');
        [k, String(votos[k] * 1000), `${pct.toLocaleString('es-ES', { maximumFractionDigits: 1 })} %`, String(res[k])].forEach((v) => {
          const td = document.createElement('td');
          td.textContent = v;
          tr.append(td);
        });
        tabla.append(tr);
      }
      const fuera = Object.keys(votos).filter((k) => !entran.includes(k) && votos[k] > 0);
      const frases = [];
      if (escanos === 1) frases.push('Con 1 escaño, se lo lleva el partido con más votos: la fórmula no cambia nada.');
      if (fuera.length) frases.push(`${fuera.join(' y ')} ${fuera.length > 1 ? 'tienen' : 'tiene'} menos del 3 % y se ${fuera.length > 1 ? 'quedan' : 'queda'} fuera del reparto.`);
      frases.push(Object.keys(votos).map((k) => `${k}: ${res[k]}`).join(', ') + ` de ${escanos} escaños.`);
      explicacion.textContent = frases.join(' ');
    }
    inputs.forEach((i) => i.addEventListener('input', pintar));
    pintar();
  });
</script>
