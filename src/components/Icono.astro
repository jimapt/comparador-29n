---
interface Props { nombre: 'volver' | 'cerrar' | 'externo' | 'compartir' | 'siguiente'; tam?: number }
const { nombre, tam = 20 } = Astro.props;
const trazos = {
  volver: 'M15 18l-6-6 6-6',
  siguiente: 'M9 6l6 6-6 6',
  cerrar: 'M6 6l12 12M18 6L6 18',
  externo: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  compartir: 'M12 3v12M7 8l5-5 5 5M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6',
};
---
<svg width={tam} height={tam} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={trazos[nombre]} /></svg>
