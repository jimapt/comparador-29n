---
// Franja de contexto para quien llega directamente a una página interior
// (por ejemplo, desde una story) sin pasar por la portada.
import Icono from './Icono.astro';
import { url } from '../lib/datos';
import { NOMBRE } from '../config';
---
<aside class="bienvenida" data-bienvenida hidden aria-labelledby="bienvenida-t">
  <div class="bienvenida__cabecera">
    <p class="bienvenida__marca" id="bienvenida-t"><a href={url()}>{NOMBRE}</a> · elecciones del 29N</p>
    <button type="button" class="boton-icono bienvenida__cerrar" data-cerrar-bienvenida aria-label="Cerrar esta explicación"><Icono nombre="cerrar" tam={16} /></button>
  </div>
  <p>Comparamos lo que propone cada partido sobre vivienda, empleo, inmigración y pensiones, en 25 palabras y con la página del programa. No te decimos qué votar.</p>
  <a class="boton boton--sec" href={url('empezar')} data-cambiar>Empezar por mi situación</a>
</aside>

<style>
  .bienvenida {
    background: var(--paper); border: 2px solid var(--ink); border-radius: var(--r-card);
    padding: 0.875rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.625rem; font-size: 0.9375rem;
  }
  .bienvenida[hidden] { display: none; }
  .bienvenida__cabecera { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .bienvenida__marca { font-family: var(--display); font-weight: 700; font-size: 0.875rem; }
  .bienvenida__marca a { text-decoration: none; }
  .bienvenida .boton { font-size: 0.9375rem; min-height: 2.75rem; }
</style>

<script>
  import { perfil } from '../scripts/perfil';
  const p = perfil();
  let cerrada = false;
  try { cerrada = sessionStorage.getItem('ltt-bienvenida') === '1'; } catch {}
  const el = document.querySelector<HTMLElement>('[data-bienvenida]');
  let interno = false;
  try { interno = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch {}
  if (el && !cerrada && !interno && !p.situaciones.length && !p.provincia) {
    el.hidden = false;
    el.querySelector('[data-cerrar-bienvenida]')!.addEventListener('click', () => {
      el.hidden = true;
      try { sessionStorage.setItem('ltt-bienvenida', '1'); } catch {}
      document.getElementById('contenido')?.focus();
    });
  }
</script>
