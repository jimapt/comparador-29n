---
import Base from '../../layouts/Base.astro';
import FormaTema from '../../components/FormaTema.astro';
import Bienvenida from '../../components/Bienvenida.astro';
import Pildora from '../../components/Pildora.astro';
import Icono from '../../components/Icono.astro';
import EtiquetaTema from '../../components/EtiquetaTema.astro';
import TarjetaPregunta from '../../components/TarjetaPregunta.astro';
import { url, temas, preguntasDeTema, type Tema } from '../../lib/datos';

export function getStaticPaths() {
  return temas.map((t) => ({ params: { tema: t.id }, props: { tema: t } }));
}
const { tema } = Astro.props as { tema: Tema };
const lista = preguntasDeTema(tema.id);
const otros = temas.filter((t) => t.id !== tema.id);
---
<Base titulo={tema.nombre} tema={tema.id} nav="para-ti" descripcion={`Qué proponen los partidos sobre ${tema.nombre.toLowerCase()} para el 29N, con la fuente de cada respuesta.`}>
  <div class="contenedor pila" style="--gap: 1.25rem">
    <header class="cabecera">
      <a class="boton-icono" href={url('para-ti')} aria-label="Volver a Para ti"><Icono nombre="volver" /></a>
      <Pildora />
    </header>
    <Bienvenida />
    <div class="heroe">
      <FormaTema forma={tema.forma} color="var(--surface)" trazo class="heroe__forma" />
      <div class="pila" style="--gap: 0.5rem">
        <EtiquetaTema tema={tema.id} extra={`${lista.length} preguntas`} />
        <h1 class="display">{tema.nombre}</h1>
      </div>
    </div>
    <p>{tema.descripcion} En cada pregunta, todos los partidos responden en el mismo formato y con la fuente.</p>
    <ol class="lista preguntas">
      {lista.map((p, i) => <TarjetaPregunta pregunta={p} i={i} />)}
    </ol>
    <section class="pila" style="--gap: 0.75rem" aria-labelledby="otros-temas">
      <h2 class="h2" id="otros-temas">Otros temas</h2>
      <ul class="lista">
        {otros.map((t) => <li><a class="tarjeta-enlace" href={url(t.id)} style={`--c: ${t.color}`}><span class="titulo">{t.nombre}</span></a></li>)}
      </ul>
    </section>
  </div>
</Base>
<style>
  .heroe { display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem; }
  .heroe :global(.heroe__forma) { flex: none; width: 5.5rem; height: 5.5rem; filter: drop-shadow(4px 4px 0 var(--ink)); }
  .preguntas :global(.tarjeta-enlace) { background: var(--surface); box-shadow: var(--shadow); }
</style>
