---
import Base from '../layouts/Base.astro';
import FormaTema from '../components/FormaTema.astro';
import { url, temas, familias, partidos, preguntas, preguntasDeTema, urlPregunta, situaciones, listaTemas } from '../lib/datos';
import { NOMBRE } from '../config';

// Una pregunta de ejemplo por tema (la primera), agrupadas por familia.
const grupos = familias.map((f) => ({ ...f, ejemplos: f.temas.map((t) => ({ tema: t, pregunta: preguntasDeTema(t.id)[0] })) }));
const pasos = [
  { n: 1, titulo: 'Cuéntanos tu situación', texto: `Si alquilas, estudias, trabajas, cobras pensión… Hay ${situaciones.situaciones.length} opciones y puedes elegir varias.` },
  { n: 2, titulo: 'Elige dónde votas', texto: 'Así ves solo los partidos que se presentan en tu provincia.' },
  { n: 3, titulo: 'Compara', texto: 'Cada partido responde a la misma pregunta en 25 palabras, con la página del programa de donde sale.' },
];
---
<Base titulo={NOMBRE} fondo="paper">
  <div class="contenedor portada pila" style="--gap: 1.125rem">
    <header class="cabecera">
      <span class="marca">{NOMBRE}</span>
      <span class="chapa-29n" aria-hidden="true">
        <svg class="urna" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <g class="urna__papeleta">
            <path fill="#fff" d="M8 11V3.5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1V11" />
            <path d="M10.5 6.5l1.2 1.2 2.3-2.4" />
          </g>
          <path fill="#fff" d="M3.5 11h17v8.5a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5z" />
          <path d="M9 15h6" />
        </svg>29N</span>
    </header>

    <div class="formas-temas" aria-hidden="true" data-visibles="8">
      {temas.map((t) => <FormaTema forma={t.forma} color={t.color} trazo />)}
    </div>

    <p class="antetitulo">Elecciones generales · 29 de noviembre</p>
    <h1 class="display">¿Qué proponen sobre lo tuyo?</h1>
    <p>Nos hemos leído los programas de {partidos.length} partidos: los que tienen representación en el Congreso, en un parlamento autonómico o en el Parlamento Europeo. Te contamos qué proponen sobre {listaTemas}, en corto y con la página de donde sale.</p>
    <ul class="sellos pequeno" aria-label="Lo que prometemos">
      {['No te decimos qué votar', 'Sin cuentas', 'No guardamos nada'].map((t) => (
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>{t}</li>
      ))}
    </ul>

    <div class="pila" style="--gap: 0.5rem">
      <a class="boton" href={url('empezar')}>Empezar</a>
      <a class="enlace" style="align-self: center" href={url('para-ti')}>Ver todas las preguntas</a>
    </div>

    <section class="pila bloque" style="--gap: 0.75rem" aria-labelledby="que-hay">
      <h2 class="h2" id="que-hay">Qué vas a encontrar</h2>
      <p class="secundario">{preguntas.length} preguntas concretas, 3 por tema, en {familias.length} grupos. Por ejemplo:</p>
      {grupos.map((g) => (
        <div class="familia pila" style="--gap: 0.5rem">
          <h3 class="familia__titulo">{g.nombre} <span class="secundario">· {g.descripcion}</span></h3>
          <ul class="lista">
            {g.ejemplos.map(({ tema, pregunta }) => (
              <li>
                <a class="tarjeta-enlace" href={urlPregunta(pregunta)} style={`--c: ${tema.color}`}>
                  <span class="etiqueta-tema" style={`--c: ${tema.color}`}><FormaTema forma={tema.forma} class="forma" />{tema.nombre}</span>
                  <span class="titulo">{pregunta.titulo}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="pila bloque" style="--gap: 0.75rem" aria-labelledby="como">
      <h2 class="h2" id="como">Cómo funciona</h2>
      <ol class="pasos">
        {pasos.map((p) => (
          <li>
            <span class="pasos__n" aria-hidden="true">{p.n}</span>
            <span><strong>{p.titulo}.</strong> {p.texto}</span>
          </li>
        ))}
      </ol>
      <a class="boton" href={url('empezar')}>Empezar</a>
    </section>

    <footer class="pie">
      <p>Es un proyecto independiente, sin relación con ningún partido. Las respuestas las prepara una IA y las revisa una persona contra el programa original.</p>
      <p><a href={url('mas/como-lo-hacemos')}>Cómo lo hacemos</a> · <a href={url('mas/fuentes')}>Fuentes</a> · <a href={url('mas/privacidad')}>Privacidad</a></p>
    </footer>
  </div>
</Base>


<style>
  .portada { padding-bottom: 2rem; }
  main { padding-bottom: 1rem; }
  /* Dos filas de 4 formas, centradas y a todo el ancho (Laura, 03/11). La novena espera fuera
     y scripts/formas.ts la va cambiando por otra: siempre se ve la que ocupa el sitio 9 escondida. */
  .formas-temas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); justify-items: center; gap: 0.5rem 0.75rem; width: 100%; max-width: 22rem; margin: 0.375rem auto 0; }
  .formas-temas :global(svg) { width: 100%; max-width: 4.25rem; height: auto; aspect-ratio: 1; }
  .formas-temas :global(svg:nth-child(n + 9)) { display: none; }
  .familia { margin-top: 0.375rem; }
  .familia__titulo { font-size: 1rem; font-weight: 800; margin: 0; }
  .familia__titulo .secundario { font-weight: 400; }
  .antetitulo { font-weight: 700; font-size: 0.9375rem; }
  .sellos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; color: var(--ink-2); }
  .sellos li { display: inline-flex; align-items: center; gap: 0.3rem; }
  .bloque { margin-top: 1.5rem; }
  .pasos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.875rem; }
  .pasos li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; align-items: start; }
  .pasos__n {
    width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--ink); color: var(--paper);
    display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 800;
  }
</style>
