---
import Pagina from '../../layouts/Pagina.astro';
import { partidos, respuestas, fuenteEscanos2023, fuenteEscanos2026 } from '../../lib/datos';
// Fuentes extra (prensa, webs) que usan algunas respuestas, por partido.
const extra = (id: string) => [...new Set(respuestas.filter((r) => r.partido === id && r.enlaces.length).map((r) => JSON.stringify({ url: r.enlaces[0], texto: r.fuente })))].map((s) => JSON.parse(s) as { url: string; texto: string });
---
<Pagina titulo="Fuentes" descripcion="Todos los documentos que hemos leído para el comparador.">
  <p>Estos son los documentos de los que salen las respuestas. Los enlaces van a la web de cada partido o, si no hay copia oficial, a la copia pública que hemos usado.</p>
  {partidos.map((p) => (
    <section class="pila" style="--gap: 0.375rem">
      <h2>{p.nombre} <span class="pequeno secundario">· {p.nombreLargo}</span></h2>
      <p>{p.documento.url ? <a href={p.documento.url} target="_blank" rel="noopener noreferrer">{p.documento.titulo}</a> : p.documento.titulo}</p>
      {p.nota && <p class="pequeno secundario">{p.nota}</p>}
      {extra(p.id).length > 0 && (
        <ul class="pequeno">
          {extra(p.id).map((e) => <li><a href={e.url} target="_blank" rel="noopener noreferrer">{e.texto}</a></li>)}
        </ul>
      )}
    </section>
  ))}
  <h2>Escaños por provincia</h2>
  <p>Los del 29N: <a href={fuenteEscanos2026.url} target="_blank" rel="noopener noreferrer">{fuenteEscanos2026.titulo}</a>. Los de 2023: {fuenteEscanos2023.url ? <a href={fuenteEscanos2023.url} target="_blank" rel="noopener noreferrer">{fuenteEscanos2023.titulo}</a> : fuenteEscanos2023.titulo}.</p>
</Pagina>
