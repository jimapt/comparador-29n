---
import Base from '../../layouts/Base.astro';
import Bienvenida from '../../components/Bienvenida.astro';
import Pildora from '../../components/Pildora.astro';
import Icono from '../../components/Icono.astro';
import Simulador from '../../components/Simulador.astro';
import {
  url, provincias, provinciasAlfabetico, partidosEn, partidosProvisional, listaEn, fuentePartidos, fuenteEscanos2023, fuenteEscanos2026, escanos2023Verificado,
  type Provincia,
} from '../../lib/datos';

export function getStaticPaths() {
  return provincias.map((p) => ({ params: { provincia: p.slug }, props: { provincia: p } }));
}
const { provincia } = Astro.props as { provincia: Provincia };
const escanos = provincia.escanos2026 ?? provincia.escanos2023;
const aqui = partidosEn(provincia.slug);
---
<Base titulo={`Lo que pesa tu voto en ${provincia.nombre}`} nav="provincia" descripcion={`Cuántos escaños reparte ${provincia.nombre} el 29N, cómo se reparten y qué partidos se presentan.`}>
  <div class="contenedor pila" style="--gap: 1rem">
    <header class="cabecera">
      <a class="boton-icono" href={url('provincia')} aria-label="Elegir otra provincia"><Icono nombre="volver" /></a>
      <Pildora />
    </header>
    <Bienvenida />
    <form class="elegir" data-elegir action={url('provincia')}>
      <label for="elegir-provincia" class="pequeno"><strong>Estás viendo</strong></label>
      <div class="elegir__fila">
        <select id="elegir-provincia" name="p" class="campo">
          {provinciasAlfabetico.map((p) => <option value={p.slug} selected={p.slug === provincia.slug}>{p.nombre}</option>)}
        </select>
        <button type="submit" class="boton boton--sec">Ver</button>
      </div>
    </form>
    <h1 class="display">Lo que pesa tu voto</h1>
    <p>En las generales no votas una lista para toda España: cada provincia elige sus propios diputados y los reparte entre los partidos que más votos sacan allí. Por eso importa dónde votas.</p>

    <section class="tarjeta cifra" aria-labelledby="escanos-t" style="background: var(--paper)">
      <h2 class="solo-lector" id="escanos-t">Escaños</h2>
      {provincia.escanos2026 !== null ? (
        <>
          <p class="cifra__n">{provincia.escanos2026}</p>
          <p>de los 350 diputados del Congreso se eligen en {provincia.nombre} el 29N.<br /><span class="pequeno"><strong>Fuente:</strong> {fuenteEscanos2026.url ? <a href={fuenteEscanos2026.url} target="_blank" rel="noopener noreferrer">{fuenteEscanos2026.titulo}</a> : fuenteEscanos2026.titulo}</span></p>
        </>
      ) : (
        <>
          <p class="cifra__n">{provincia.escanos2023}</p>
          <p>escaños repartió {provincia.nombre} en 2023.<br />
            <span class="pequeno">Los del 29N se confirman con el BOE de la convocatoria. <strong>Fuente:</strong> {fuenteEscanos2023.url ? <a href={fuenteEscanos2023.url} target="_blank" rel="noopener noreferrer">{fuenteEscanos2023.titulo}</a> : fuenteEscanos2023.titulo}</span>
            {!escanos2023Verificado && <span class="pequeno"> [PENDIENTE de cotejar]</span>}
          </p>
        </>
      )}
    </section>

    <Simulador escanos={escanos} escanos2023={provincia.escanos2023} provincia={provincia.nombre} slug={provincia.slug} />

    <section class="pila" style="--gap: 0.75rem" aria-labelledby="quien-t">
      <h2 class="h2" id="quien-t">Quién se presenta aquí</h2>
      {partidosProvisional && <p class="aviso pequeno">Lista provisional: se confirma con la proclamación de candidaturas en el BOE.</p>}
      <ul class="lista">
        {aqui.map((p) => (
          <li class="tarjeta partido-fila">
            <div>
              <p class="partido">{p.nombre}</p>
              {listaEn(p, provincia.slug)
                ? <p class="pequeno secundario">Aquí se presenta como <strong>{listaEn(p, provincia.slug)}</strong></p>
                : p.nombreLargo !== p.nombre && <p class="pequeno secundario">{p.nombreLargo}</p>}
            </div>
            {p.documento.url
              ? <a class="pequeno" href={p.documento.url} target="_blank" rel="noopener noreferrer">{p.documento.titulo}<span class="solo-lector"> (se abre en otra pestaña)</span></a>
              : <span class="pequeno secundario">{p.documento.titulo}</span>}
          </li>
        ))}
      </ul>
      <p class="pequeno secundario">Ordenados alfabéticamente. Solo los partidos del comparador; en {provincia.nombre} se presentan más. <strong>Fuente:</strong> <a href={fuentePartidos.url} target="_blank" rel="noopener noreferrer">{fuentePartidos.titulo}<span class="solo-lector"> (se abre en otra pestaña)</span></a></p>
    </section>

    <a class="boton boton--sec" href={url('empezar/provincia')} data-cambiar>Cambiar de provincia</a>
  </div>
</Base>

<script>
  import { guardarPerfil } from '../../scripts/perfil';
  const form = document.querySelector<HTMLFormElement>('[data-elegir]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const slug = (form.elements.namedItem('p') as HTMLSelectElement).value;
    guardarPerfil({ provincia: slug });
    location.href = form.action.replace(/\/?$/, '/') + slug + '/';
  });
</script>

<style>
  .elegir { display: grid; gap: 0.375rem; }
  .elegir__fila { display: flex; gap: 0.5rem; }
  .elegir .boton { width: auto; flex: none; min-height: 3rem; }
  .elegir select { flex: 1 1 auto; width: 100%; min-width: 0; min-height: 3rem; font: inherit; font-weight: 700; padding: 0 0.75rem; border: 2px solid var(--ink); border-radius: 12px; background: #fff; color: var(--ink); }
  .cifra { display: flex; gap: 1rem; align-items: center; }
  .cifra__n { font-family: var(--display); font-weight: 800; font-size: 3.5rem; line-height: 1; flex: none; }
  .partido-fila { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; box-shadow: none; padding: 0.75rem 1rem; }
  .partido { font-family: var(--display); font-weight: 700; font-size: 0.9375rem; }
</style>
