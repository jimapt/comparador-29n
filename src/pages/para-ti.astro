---
import Base from '../layouts/Base.astro';
import FormaTema from '../components/FormaTema.astro';
import Bienvenida from '../components/Bienvenida.astro';
import Pildora from '../components/Pildora.astro';
import TarjetaPregunta from '../components/TarjetaPregunta.astro';
import { url, preguntas, temas, familias, situaciones, pregunta } from '../lib/datos';
import { NOMBRE } from '../config';
const orden = situaciones.porDefecto.map(pregunta);
// Laura (04/11): se ven como mucho 6 preguntas (las que te afectan, o las 6 primeras si no has
// elegido situación); el resto va plegado en "Ver todas las preguntas".
const VISIBLES = 6;
---
<Base titulo="Para ti" fondo="paper" nav="para-ti">
  <div class="contenedor pila" style="--gap: 1.25rem">
    <header class="cabecera">
      <a class="marca" href={url()}>{NOMBRE}</a>
      <Pildora />
    </header>
    <Bienvenida />
    <div class="formas-mini" aria-hidden="true">
      {temas.map((t) => <FormaTema forma={t.forma} color={t.color} trazo />)}
    </div>
    <div class="pila" style="--gap: 0.375rem">
      <h1 class="display">Para ti</h1>
      <p class="secundario" data-subtitulo>{preguntas.length} preguntas sobre {temas.length} temas. Elige tu situación y te ponemos primero las que más te afectan.</p>
    </div>

    <ol class="lista" data-lista-preguntas aria-label="Preguntas">
      {orden.slice(0, VISIBLES).map((p, i) => <TarjetaPregunta pregunta={p} i={i} />)}
    </ol>

    <details class="mas-preguntas" data-mas-preguntas>
      <summary class="boton boton--sec"><span data-mas-texto>Ver todas las preguntas ({orden.length - VISIBLES} más)</span></summary>
      <ol class="lista" data-lista-resto aria-label="Más preguntas">
        {orden.slice(VISIBLES).map((p, i) => <TarjetaPregunta pregunta={p} i={i} />)}
      </ol>
    </details>

    <section class="pila" style="--gap: 0.75rem" aria-labelledby="por-temas">
      <h2 class="h2" id="por-temas">Por temas</h2>
      {familias.map((f) => (
        <div class="pila" style="--gap: 0.5rem">
          <h3 class="familia">{f.nombre}</h3>
          <ul class="temas">
            {f.temas.map((t) => (
              <li><a class="tarjeta-enlace" href={url(t.id)} style={`--c: ${t.color}`}><span class="titulo">{t.nombre}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
  <script type="application/json" id="datos-situaciones" set:html={JSON.stringify(situaciones)} />
</Base>

<style>
  /* Las 9 formas siempre en una fila: se encogen con la pantalla, nunca saltan de línea (Laura, 04/11). */
  .formas-mini { display: grid; grid-template-columns: repeat(var(--cols, 9), minmax(0, 2.25rem)); gap: 0.3rem; margin-top: 0.25rem; }
  .mas-preguntas > summary { list-style: none; cursor: pointer; }
  .mas-preguntas > summary::-webkit-details-marker { display: none; }
  .mas-preguntas[open] > summary { margin-bottom: 0.75rem; }
  .familia { font-size: 1rem; font-weight: 800; margin: 0; }
  .formas-mini :global(svg) { width: 100%; height: auto; aspect-ratio: 1; }
  .temas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
</style>

<script>
  import { perfil } from '../scripts/perfil';
  import { ordenParaTi } from '../scripts/orden';
  const datos = JSON.parse(document.getElementById('datos-situaciones')!.textContent!);
  const { situaciones } = perfil();
  if (situaciones.length) {
    const { orden, afectan } = ordenParaTi(datos, situaciones);
    const lista = document.querySelector('[data-lista-preguntas]')!;
    const resto = document.querySelector('[data-lista-resto]')!;
    const items = new Map([...lista.children, ...resto.children].map((li) => [(li as HTMLElement).dataset.pregunta!, li as HTMLElement]));
    const visibles = Math.min(6, afectan.size || 6);
    orden.forEach((id, i) => {
      const li = items.get(id)!;
      li.style.setProperty('--i', String(i < visibles ? i : i - visibles));
      (i < visibles ? lista : resto).append(li);
      const marca = li.querySelector<HTMLElement>('[data-te-afecta]')!;
      marca.hidden = !afectan.has(id);
      li.querySelector('a')!.dataset.afecta = String(afectan.has(id));
    });
    document.querySelector('[data-subtitulo]')!.textContent =
      `${orden.length} preguntas. Aquí tienes las que más te afectan.`;
    document.querySelector('[data-mas-texto]')!.textContent = `Ver todas las preguntas (${orden.length - visibles} más)`;
  }
</script>
